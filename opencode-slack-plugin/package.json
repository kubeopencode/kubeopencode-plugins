{
  "name": "@kubeopencode/opencode-slack-plugin",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode plugin that connects to Slack via Socket Mode — zero port exposure, runs inside your OpenCode process",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "slack",
    "socket-mode",
    "bot",
    "ai",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kubeopencode/kubeopencode-plugins",
    "directory": "opencode-slack-plugin"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.13.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.15",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  }
}
